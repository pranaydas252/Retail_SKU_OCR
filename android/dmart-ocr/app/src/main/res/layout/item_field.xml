<?xml version="1.0" encoding="utf-8"?>
<!--
    One editable field on the confirmation screen, sized for a half-width grid
    cell.

    Three deliberate choices, each fixing a real defect:

    1. Confidence is a DOT, not a left rail. A rail has to be a child view with
       match_parent height, and GridLayout stretches every cell to the tallest
       card in its row — so the rail ran past the bottom of its own card. A dot
       cannot bleed.

    2. The label wraps to two lines and is never ellipsized. "Manufacturing
       date" does not fit a half-width cell on one line, and truncating it to
       "Manufactu..." hides the one thing the operator needs: which field they
       are checking.

    3. The reason line always occupies its line, and is merely INVISIBLE when
       there is nothing to say. Collapsing it made cards different heights
       depending on how well each field happened to be read, which turned a
       grid of five into a ragged staircase.

    Every card is therefore the same height by construction rather than by a
    hard-coded dp: a fixed two-line label, a single-line value, and a
    single-line note. Nothing here sizes to its own content, so nothing can
    make one card taller than its neighbour.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <View
                android:id="@+id/bandDot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginTop="3dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/dot_high" />

            <!-- lines, not maxLines: "Manufacturing date" needs two lines in a
                 half-width cell and "MRP" needs one, and a card that sizes to
                 its own label is a card that does not match its neighbour. -->
            <TextView
                android:id="@+id/fieldLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:lines="2"
                android:textAppearance="@style/TextAppearance.DmartOcr.FieldKey"
                tools:text="Manufacturing date" />

            <!-- Only shown for rows the operator added themselves. -->
            <ImageView
                android:id="@+id/removeButton"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginTop="-4dp"
                android:layout_marginEnd="-4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/result_remove_field"
                android:padding="7dp"
                android:src="@drawable/ic_close"
                android:visibility="gone"
                app:tint="@color/text_tertiary"
                tools:visibility="visible" />
        </LinearLayout>

        <!--
            Single line, and no textMultiLine.

            Every value this screen carries is short by nature - a date, a
            price, a batch code - so wrapping was only ever reachable by a bad
            read, and letting a bad read stretch its card is the wrong response
            to it. A long value scrolls horizontally while being edited instead.
        -->
        <EditText
            android:id="@+id/fieldValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:hint="@string/result_not_found"
            android:importantForAutofill="no"
            android:inputType="textCapCharacters"
            android:maxLines="1"
            android:minHeight="26dp"
            android:paddingTop="2dp"
            android:paddingBottom="0dp"
            android:textAppearance="@style/TextAppearance.DmartOcr.Value"
            android:textColorHint="@color/text_tertiary"
            tools:text="2026-07" />

        <!-- Says WHY a value is doubtful. A band with no reason only tells the
             operator to worry; this tells them what to look at.

             Always one line, INVISIBLE rather than GONE when there is nothing
             to say, so a well-read field does not shrink its card relative to
             a doubtful one. -->
        <TextView
            android:id="@+id/fieldNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:lines="1"
            android:textAppearance="@style/TextAppearance.DmartOcr.FieldNote"
            android:visibility="invisible"
            tools:text="Check this"
            tools:visibility="visible" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
