<?xml version="1.0" encoding="utf-8"?>
<!--
    One editable field on the confirmation screen.

    Denser than a Material card on purpose: five to ten of these stack on a
    small scanner screen, and the operator is comparing each against printed
    text on a pack. Vertical space spent on padding is space not spent showing
    the next field.

    The key is styled as a real label — 12sp medium in the secondary text
    colour — rather than a faint caption. It was previously 11sp tertiary,
    which made "MRP" and "Manufacturing date" nearly invisible against the
    value beneath them.

    Confidence is carried by the left rail and the chip together, so it
    survives colour blindness and glare.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_field"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <View
        android:id="@+id/bandRail"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="@color/band_high" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/fieldLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.DmartOcr.FieldKey"
                tools:text="Manufacturing date" />

            <TextView
                android:id="@+id/bandChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_high"
                android:includeFontPadding="false"
                android:paddingHorizontal="9dp"
                android:paddingVertical="4dp"
                android:textAppearance="@style/TextAppearance.DmartOcr.BandChip"
                android:textColor="@color/band_high"
                tools:text="Clear" />

            <!-- Only shown for rows the operator added themselves. -->
            <ImageView
                android:id="@+id/removeButton"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/result_remove_field"
                android:padding="7dp"
                android:src="@drawable/ic_close"
                android:visibility="gone"
                app:tint="@color/text_tertiary"
                tools:visibility="visible" />
        </LinearLayout>

        <EditText
            android:id="@+id/fieldValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:hint="@string/result_not_found"
            android:importantForAutofill="no"
            android:inputType="textCapCharacters"
            android:maxLines="1"
            android:minHeight="34dp"
            android:paddingVertical="0dp"
            android:textAppearance="@style/TextAppearance.DmartOcr.Value"
            android:textColorHint="@color/text_tertiary"
            tools:text="2026-07" />

        <!-- Explains WHY a value is uncertain. A band with no reason just tells
             the operator to worry; this tells them what to look at. -->
        <TextView
            android:id="@+id/fieldNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.DmartOcr.Body"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="Calculated from the manufacturing date"
            tools:visibility="visible" />

    </LinearLayout>

</LinearLayout>
