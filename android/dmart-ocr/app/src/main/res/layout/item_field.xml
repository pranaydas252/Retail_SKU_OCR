<?xml version="1.0" encoding="utf-8"?>
<!--
    One editable field on the confirmation screen, sized for a half-width grid
    cell.

    Three deliberate choices, each fixing a real defect:

    1. Confidence is a DOT, not a left rail. A rail has to be a child view with
       match_parent height, and GridLayout stretches every cell to the tallest
       card in its row — so the rail ran past the bottom of its own card. A dot
       cannot bleed.

    2. The label wraps to two lines and is never ellipsized. "Manufacturing
       date" does not fit a half-width cell on one line, and truncating it to
       "Manufactu..." hides the one thing the operator needs: which field they
       are checking.

    3. The reason line appears only when a value is doubtful. A clear field
       stays two lines and quiet; an uncertain one spends a third line saying
       so in words, so the signal never depends on colour alone.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="11dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <View
                android:id="@+id/bandDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/dot_high" />

            <TextView
                android:id="@+id/fieldLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.DmartOcr.FieldKey"
                tools:text="Manufacturing date" />

            <!-- Only shown for rows the operator added themselves. -->
            <ImageView
                android:id="@+id/removeButton"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginTop="-4dp"
                android:layout_marginEnd="-4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/result_remove_field"
                android:padding="7dp"
                android:src="@drawable/ic_close"
                android:visibility="gone"
                app:tint="@color/text_tertiary"
                tools:visibility="visible" />
        </LinearLayout>

        <EditText
            android:id="@+id/fieldValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:hint="@string/result_not_found"
            android:importantForAutofill="no"
            android:inputType="textCapCharacters|textMultiLine"
            android:maxLines="3"
            android:minHeight="30dp"
            android:paddingTop="4dp"
            android:paddingBottom="0dp"
            android:textAppearance="@style/TextAppearance.DmartOcr.Value"
            android:textColorHint="@color/text_tertiary"
            tools:text="2026-07" />

        <!-- Says WHY a value is doubtful. A band with no reason only tells the
             operator to worry; this tells them what to look at. -->
        <TextView
            android:id="@+id/fieldNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textAppearance="@style/TextAppearance.DmartOcr.FieldNote"
            android:visibility="gone"
            tools:text="Check this"
            tools:visibility="visible" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
