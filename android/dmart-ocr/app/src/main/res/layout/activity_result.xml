<?xml version="1.0" encoding="utf-8"?>
<!--
    Confirmation. The operator is the final authority before anything is
    committed (CLAUDE.md §4), so every field is editable and nothing here is
    read-only.

    Fields are ordered worst-confidence-first at runtime rather than in a fixed
    order. The values most likely to be wrong should not be below the fold.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    tools:context=".ui.ResultActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="16dp">


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/result_title"
                android:textAppearance="@style/TextAppearance.DmartOcr.Display" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/result_subtitle"
                android:textAppearance="@style/TextAppearance.DmartOcr.Body" />

            <!-- Summary banner: one line telling the operator whether they can
                 skim or must look carefully. -->
            <LinearLayout
                android:id="@+id/summaryBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_chip_high"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="9dp">

                <ImageView
                    android:id="@+id/summaryIcon"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginEnd="9dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_check"
                    app:tint="@color/band_high" />

                <TextView
                    android:id="@+id/summaryText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:includeFontPadding="false"
                    android:textAppearance="@style/TextAppearance.DmartOcr.SummaryChip"
                    android:textColor="@color/band_high"
                    tools:text="All values read clearly" />
            </LinearLayout>

            <!-- Shown only when the scan did not reach the database. -->
            <LinearLayout
                android:id="@+id/unsavedBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_chip_low"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_alert"
                    app:tint="@color/band_low" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/result_unsaved"
                    android:textAppearance="@style/TextAppearance.DmartOcr.Body"
                    android:textColor="@color/band_low" />
            </LinearLayout>

            <!-- Two columns. Batch codes, dates and prices are all short, so a
                 full-width row per field wasted most of the screen and pushed
                 the rest below the fold. -->
            <androidx.gridlayout.widget.GridLayout
                android:id="@+id/fieldContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                app:columnCount="2"
                app:useDefaultMargins="false" />

            <!-- OCR will miss things, and the field set is not fixed. The
                 operator needs a way to record something the server never
                 returned rather than losing it. -->
            <LinearLayout
                android:id="@+id/addFieldButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_add_field"
                android:baselineAligned="false"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingVertical="14dp">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_add"
                    app:tint="@color/brand_cyan" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/result_add_field"
                    android:textAppearance="@style/TextAppearance.DmartOcr.Title"
                    android:textColor="@color/brand_cyan" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/retakeButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="58dp"
            android:layout_marginEnd="12dp"
            android:text="@string/result_retake"
            android:textColor="@color/text_primary"
            app:cornerRadius="18dp"
            app:strokeColor="@color/outline_strong" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/confirmButton"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_weight="1"
            android:text="@string/result_confirm"
            app:backgroundTint="@color/brand_cyan"
            app:cornerRadius="18dp"
            app:icon="@drawable/ic_check"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconSize="20dp"
            app:rippleColor="@color/ripple_on_brand" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
