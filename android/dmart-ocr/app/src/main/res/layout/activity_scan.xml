<?xml version="1.0" encoding="utf-8"?>
<!--
    Camera. Dark chrome around a live viewfinder.

    RoiOverlayView draws the scrim and the cut-out window, and is also the
    single source of truth for the ROI rectangle used to crop the capture. The
    view that the operator aims with is literally the view that defines the
    crop, so the two cannot drift apart.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:context=".ui.ScanActivity">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:implementationMode="performance"
        app:scaleType="fitCenter" />

    <!--
        The still that was actually captured, shown over the live preview while
        the scan is processed.

        Without this the Preview use case keeps streaming after the shutter, so
        the screen carries on moving and the operator cannot tell what was
        taken - or whether the shutter fired at all. The uploaded frame was
        always a still; only the display suggested otherwise.
    -->
    <ImageView
        android:id="@+id/capturedPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:contentDescription="@string/captured_frame"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <com.markss.dmartocr.ui.view.RoiOverlayView
        android:id="@+id/roiOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top bar -->
    <FrameLayout
        android:id="@+id/closeButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_camera_pill"
        android:clickable="true"
        android:contentDescription="@string/cd_close"
        android:focusable="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_close" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/torchButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_camera_pill"
        android:clickable="true"
        android:contentDescription="@string/cd_torch"
        android:focusable="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/torchIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_torch" />
    </FrameLayout>

    <!-- Instruction, anchored just above the ROI window at runtime. -->
    <LinearLayout
        android:id="@+id/instructionGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:layout_marginTop="200dp">

        <TextView
            android:id="@+id/instruction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_camera_pill"
            android:paddingHorizontal="18dp"
            android:paddingVertical="10dp"
            android:text="@string/scan_instruction"
            android:textAppearance="@style/TextAppearance.DmartOcr.Title"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/instructionHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="0.75"
            android:text="@string/scan_hint"
            android:textAppearance="@style/TextAppearance.DmartOcr.Body"
            android:textColor="@android:color/white" />
    </LinearLayout>

    <!-- Capture -->
    <FrameLayout
        android:id="@+id/captureButton"
        android:layout_width="82dp"
        android:layout_height="82dp"
        android:layout_marginBottom="44dp"
        android:background="@drawable/bg_capture_button"
        android:clickable="true"
        android:contentDescription="@string/cd_capture"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Processing overlay. Covers the whole screen so the operator cannot
         fire a second capture into a request already in flight. -->
    <FrameLayout
        android:id="@+id/processingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D9000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        tools:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                app:indicatorColor="@color/brand_cyan"
                app:indicatorSize="48dp"
                app:trackThickness="4dp" />

            <TextView
                android:id="@+id/processingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/scan_processing"
                android:textAppearance="@style/TextAppearance.DmartOcr.Headline"
                android:textColor="@android:color/white" />

            <TextView
                android:id="@+id/processingHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:alpha="0.7"
                android:text="@string/scan_processing_hint"
                android:textAppearance="@style/TextAppearance.DmartOcr.Body"
                android:textColor="@android:color/white" />
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
