<?xml version="1.0" encoding="utf-8"?>
<!--
    Type scale.

    Google Sans is bundled as three static weights (400/500/700), subset to
    Latin plus the rupee sign. Weight, not size, carries most of the hierarchy
    here: the screens are short, and a small number of sizes keeps a dense
    field list from looking noisy.

    Field VALUES are set in medium at a generous size and with slight negative
    tracking, because they are the only thing on the confirmation screen the
    operator actually has to read character by character.
-->
<resources>

    <style name="TextAppearance.DmartOcr.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="fontFamily">@font/google_sans</item>
        <item name="android:fontFamily">@font/google_sans</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">30sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.DmartOcr.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/google_sans</item>
        <item name="android:fontFamily">@font/google_sans</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.DmartOcr.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/google_sans</item>
        <item name="android:fontFamily">@font/google_sans</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.DmartOcr.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/google_sans</item>
        <item name="android:fontFamily">@font/google_sans</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.35</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Field labels: small, uppercase, widely tracked. Reads as a caption
         rather than competing with the value beneath it. -->
    <style name="TextAppearance.DmartOcr.Label" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">@font/google_sans</item>
        <item name="android:fontFamily">@font/google_sans</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.09</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>

    <!-- Field keys on the confirmation screen.
         Sentence case at 12sp medium in the secondary colour. The earlier
         11sp all-caps tertiary caption was effectively invisible next to the
         value, and the operator needs to know WHICH field they are checking. -->
    <style name="TextAppearance.DmartOcr.FieldKey" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/google_sans</item>
        <item name="android:fontFamily">@font/google_sans</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">11.5sp</item>
        <item name="android:letterSpacing">0.005</item>
        <item name="android:lineSpacingMultiplier">1.05</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Reason line under a doubtful value. Small, in the band colour, and
         only ever present when there is something to say. -->
    <style name="TextAppearance.DmartOcr.FieldNote" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">@font/google_sans</item>
        <item name="android:fontFamily">@font/google_sans</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Extracted values. The one thing on screen read character by character. -->
    <style name="TextAppearance.DmartOcr.Value" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/google_sans</item>
        <item name="android:fontFamily">@font/google_sans</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">-0.005</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- The one-line summary above the field grid. Smaller than Title: it is a
         status line, not a heading, and at 16sp it read as a second title
         competing with the screen's own. -->
    <style name="TextAppearance.DmartOcr.SummaryChip" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/google_sans</item>
        <item name="android:fontFamily">@font/google_sans</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.DmartOcr.BandChip" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">@font/google_sans</item>
        <item name="android:fontFamily">@font/google_sans</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="TextAppearance.DmartOcr.DialogTitle" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="fontFamily">@font/google_sans</item>
        <item name="android:fontFamily">@font/google_sans</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">21sp</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.DmartOcr.DialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="fontFamily">@font/google_sans</item>
        <item name="android:fontFamily">@font/google_sans</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/brand_cyan</item>
    </style>

    <!--
        Icon and label optically centred.

        Two defaults fight a fixed-height button. `includeFontPadding` adds the
        font's full ascent and descent above and below the glyphs, so the text
        box is taller than the letters and its centre sits below theirs, while
        the icon centres on the true content box — the icon reads high and the
        text low. MaterialButton's 6dp vertical insets then shrink the drawable
        without moving the content, which compounds it.

        Zeroing both is what makes the pair line up. The buttons here all
        declare an explicit height, so the insets are giving up nothing.
    -->
    <style name="Widget.DmartOcr.Button" parent="Widget.Material3.Button">
        <item name="fontFamily">@font/google_sans</item>
        <item name="android:fontFamily">@font/google_sans</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <!--
        The outlined variant, which has to repeat the items above rather than
        inherit them.

        `materialButtonStyle` in the theme only reaches buttons that do not
        name a style of their own, so an outlined button pointing at
        Widget.Material3.Button.OutlinedButton silently opted out of the inset
        and font-padding fixes. Two buttons side by side both declaring 58dp
        then rendered at 58dp and 46dp, because only one of them had its 6dp
        insets removed — which is exactly what it looked like.

        Android styles have single inheritance and this one needs the outlined
        appearance from its parent, so the shared items are duplicated. Any
        change above belongs here too.
    -->
    <style name="Widget.DmartOcr.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="fontFamily">@font/google_sans</item>
        <item name="android:fontFamily">@font/google_sans</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <!--
        Text fields, dense.

        The default OutlinedBox is 56dp tall and built for a form the user is
        going to spend time in. Every field in this app is a value set once at
        install, or a short correction to something already read off a pack, so
        the height was only pushing the rest of the dialog down.
    -->
    <style name="Widget.DmartOcr.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox.Dense">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/brand_cyan</item>
        <item name="hintTextColor">@color/brand_cyan</item>
    </style>

    <style name="Widget.DmartOcr.TextInput.Edit" parent="Widget.Material3.TextInputEditText.OutlinedBox.Dense">
        <item name="fontFamily">@font/google_sans</item>
        <item name="android:fontFamily">@font/google_sans</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:importantForAutofill">no</item>
        <item name="android:maxLines">1</item>
    </style>

</resources>
