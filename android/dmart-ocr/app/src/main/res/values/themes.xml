<?xml version="1.0" encoding="utf-8"?>
<!--
    Material 3, light only.

    Dynamic colour is deliberately NOT enabled. This is a single-purpose
    warehouse tool where the confidence bands carry safety meaning, and letting
    the device wallpaper retint them would undermine the one thing the operator
    must read correctly.
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.DmartOcr" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_cyan</item>
        <item name="colorOnPrimary">@color/text_on_brand</item>
        <item name="colorPrimaryContainer">@color/brand_cyan_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_ink</item>

        <item name="colorSecondary">@color/brand_ink</item>
        <item name="colorOnSecondary">@color/text_on_brand</item>

        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_sunken</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline</item>

        <item name="colorError">@color/band_low</item>
        <item name="colorOnError">@color/text_on_brand</item>

        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>

        <item name="android:fontFamily">@font/google_sans</item>
        <item name="fontFamily">@font/google_sans</item>

        <item name="textAppearanceDisplaySmall">@style/TextAppearance.DmartOcr.Display</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.DmartOcr.Headline</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.DmartOcr.Title</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.DmartOcr.Body</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.DmartOcr.Label</item>

        <item name="materialButtonStyle">@style/Widget.DmartOcr.Button</item>
    </style>

    <!-- The camera screen is the one dark surface in the app: a light chrome
         around a live viewfinder would glare in a warehouse aisle and fight
         the preview for attention. -->
    <style name="Theme.DmartOcr.Camera" parent="Theme.DmartOcr">
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>

</resources>
