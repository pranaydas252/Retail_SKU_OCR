<?xml version="1.0" encoding="utf-8"?>
<!-- Dashed outline: reads as "space you can fill" rather than a solid card
     competing with the real fields above it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <corners android:radius="16dp" />
    <stroke android:width="1dp" android:color="@color/outline_strong" android:dashWidth="6dp" android:dashGap="4dp" />
</shape>
