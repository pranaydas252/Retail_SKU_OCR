<?xml version="1.0" encoding="utf-8"?>
<!--
    Home. One job: get the operator into the camera.

    The layout is deliberately top-weighted with a single primary action pinned
    to the bottom, because this is used one-handed on a scanner gun while
    standing at a shelf. Everything above the button is context, not choice.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    tools:context=".ui.MainActivity">

    <!--
        Top bar is a constrained row: logo | server chip | settings.

        The chip is pinned between the other two and given 0dp width, so a long
        status string compresses and ellipsizes instead of growing across the
        branding. A wrap_content chip here overlapped the logo the moment the
        text read "Server unreachable".
    -->
    <ImageView
        android:id="@+id/logo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="18dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/cd_logo"
        android:src="@drawable/logo_markss"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="108dp"
        app:layout_constraintWidth_percent="0.30" />

    <!-- Server state. Placed beside the logo rather than near the button so a
         red state is visible before the operator commits to a scan. -->
    <LinearLayout
        android:id="@+id/serverChip"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintStart_toEndOf="@id/logo"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constrainedWidth="true"
        android:background="@drawable/bg_chip_neutral"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="7dp"
        app:layout_constraintBottom_toBottomOf="@id/logo"
        app:layout_constraintEnd_toStartOf="@id/settingsButton"
        app:layout_constraintTop_toTopOf="@id/logo"
        android:baselineAligned="false">

        <View
            android:id="@+id/serverDot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="7dp"
            android:minWidth="7dp"
            android:background="@drawable/bg_dot" />

        <TextView
            android:id="@+id/serverStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:gravity="center_vertical"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/main_server_checking"
            android:textAppearance="@style/TextAppearance.RetailOcr.BandChip"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/settingsButton"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_icon_button"
        android:clickable="true"
        android:contentDescription="@string/cd_settings"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="@id/logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/logo">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_settings"
            app:tint="@color/text_secondary" />
    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_default="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logo">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/main_title"
                android:textAppearance="@style/TextAppearance.RetailOcr.Display" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/main_subtitle"
                android:textAppearance="@style/TextAppearance.RetailOcr.Body" />

            <!-- Hero. A schematic label rather than a photo: it doubles as an
                 instruction for what the ROI window should end up containing. -->
            <!-- Absorbs whatever vertical space is left, with fillViewport on
                 the scroll view above. Fixed heights leave a gap on a tall
                 screen and clip on a short one. -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_hero">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_field"
                    android:orientation="vertical"
                    android:paddingHorizontal="30dp"
                    android:paddingVertical="24dp">

                    <include
                        layout="@layout/item_hero_row"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/heroRow1" />

                    <include
                        layout="@layout/item_hero_row"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/heroRow2" />

                    <include
                        layout="@layout/item_hero_row"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/heroRow3" />

                    <include
                        layout="@layout/item_hero_row"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/heroRow4" />
                </LinearLayout>
            </FrameLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background"
        android:paddingHorizontal="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!--
            Symmetric zero padding with gravity=center is what actually centres
            an icon-plus-text MaterialButton. The default style carries 16dp
            start/end padding, and with an icon present that shifts the whole
            group off-centre.
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/scanButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/main_scan_button"
            app:backgroundTint="@color/brand_cyan"
            app:cornerRadius="18dp"
            app:icon="@drawable/ic_scan"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconSize="20dp"
            app:rippleColor="@color/ripple_on_brand" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
