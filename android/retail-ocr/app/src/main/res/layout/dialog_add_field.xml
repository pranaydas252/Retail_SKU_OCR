<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="8dp">

    <!--
        The fields the server looked for and did not find, as one tap each.

        Those fields no longer get a card, so recovering one means naming it
        again — and the name is not cosmetic. It is turned into the key the
        server stores and the QR payload is built from, so "Expiry" and
        "Expiry date" are two different fields and only one of them is right.
        A chip carries the exact key across, which typing cannot.
    -->
    <TextView
        android:id="@+id/suggestionLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/add_field_suggestions"
        android:textAppearance="@style/TextAppearance.RetailOcr.Label"
        android:visibility="gone"
        tools:visibility="visible" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/suggestions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:visibility="gone"
        app:chipSpacingVertical="0dp"
        app:singleLine="false"
        tools:visibility="visible" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/nameLayout"
        style="@style/Widget.RetailOcr.TextInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/add_field_name_hint">

        <com.google.android.material.textfield.TextInputEditText
            style="@style/Widget.RetailOcr.TextInput.Edit"
            android:id="@+id/nameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/valueLayout"
        style="@style/Widget.RetailOcr.TextInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:hint="@string/add_field_value_hint">

        <com.google.android.material.textfield.TextInputEditText
            style="@style/Widget.RetailOcr.TextInput.Edit"
            android:id="@+id/valueInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapCharacters" />
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
