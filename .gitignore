android/**/*.apk
android/**/*.aab
android/**/*.ap_
android/**/*.dex
android/**/*.class
android/**/output.json
android/**/release/

# Keystores — never commit signing material
*.jks
*.keystore

# Zebra Link-OS (ZSDK) AAR is vendored locally, not committed
android/**/libs/*.aar
android/**/libs/*.jar

# Android lint
android/**/lint-results*.html
android/**/lint-results*.xml

