# D-Mart SKU Label OCR — configuration template
# Copy to .env and fill in. .env is git-ignored and must never be committed.

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=change-me-before-any-shared-deployment
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# SQL Server
# Local dev default is the SQLEXPRESS instance on this machine.
# Use ODBC Driver 18. TrustServerCertificate is acceptable for local dev only.
# ---------------------------------------------------------------------------
SQL_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=localhost\SQLEXPRESS;Database=DmartOcr;Trusted_Connection=yes;Encrypt=yes;TrustServerCertificate=yes;

# ---------------------------------------------------------------------------
# Image storage
# Scan images are written to disk; only the path is stored in SQL Server.
# Layout: <IMAGE_ROOT>/YYYY/MM/DD/SCAN-000001.jpg
# ---------------------------------------------------------------------------
IMAGE_ROOT=./images
SAVE_PROCESSED_VARIANTS=true
DEBUG_ARTIFACT_ROOT=./debug

# ---------------------------------------------------------------------------
# OCR — PaddleOCR 3.4.1 / PaddlePaddle 3.3.1 (CPU)
#
# Model names are configurable so all four PP-OCRv5 combinations can be
# A/B tested against real label images. Starting point is server detection
# (label print is small and dense) + mobile recognition (fields are short).
# ---------------------------------------------------------------------------
OCR_LANG=en
OCR_VERSION=PP-OCRv5
OCR_DET_MODEL_NAME=PP-OCRv5_server_det
OCR_REC_MODEL_NAME=PP-OCRv5_mobile_rec
OCR_MODEL_DIR=./models
OCR_USE_TEXTLINE_ORIENTATION=true
OCR_USE_DOC_ORIENTATION_CLASSIFY=false
OCR_USE_DOC_UNWARPING=false
OCR_DET_LIMIT_SIDE_LEN=960
OCR_DET_LIMIT_TYPE=max
OCR_DET_THRESH=0.3
OCR_DET_BOX_THRESH=0.6
OCR_REC_SCORE_THRESH=0.0
OCR_WARMUP_ON_STARTUP=true

# Preprocessing variants to run and compare. Keep this list short —
# CLAUDE.md section 7 forbids an uncontrolled combination explosion.
OCR_VARIANTS=original,enhanced,threshold

# ---------------------------------------------------------------------------
# Field extraction
# ---------------------------------------------------------------------------
FIELD_ALIAS_CONFIG=./config/field_aliases.yaml
CONFIDENCE_HIGH_THRESHOLD=0.95
CONFIDENCE_REVIEW_THRESHOLD=0.80

# ---------------------------------------------------------------------------
# Printer — Zebra ZQ320 over Bluetooth via ZSDK (Link-OS), ZPL
# The Android app owns the Bluetooth connection; the server prepares payloads.
# ---------------------------------------------------------------------------
PRINTER_DPI=203
QR_SIZE_MM=10
QR_MAGNIFICATION=2
QR_ERROR_CORRECTION=M
