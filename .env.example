# Reliance Retail SKU Label OCR — configuration template
# Copy to .env and fill in. .env is git-ignored and must never be committed.

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Leave blank for local development. Blank means unauthenticated, and the
# server logs a warning on every request so it cannot be missed.
API_KEY=
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# SQL Server
# Local dev default is the SQLEXPRESS instance on this machine.
# ODBC Driver 18. TrustServerCertificate is acceptable for local dev only.
# ---------------------------------------------------------------------------
SQL_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=localhost\SQLEXPRESS;Database=RetailOcr;Trusted_Connection=yes;Encrypt=yes;TrustServerCertificate=yes;

# ---------------------------------------------------------------------------
# Image storage
# Scan images are written to disk; only the path is stored in SQL Server.
# Layout: <IMAGE_ROOT>/YYYY/MM/DD/SCAN-000001.jpg
# ---------------------------------------------------------------------------
IMAGE_ROOT=./images
DEBUG_ARTIFACT_ROOT=./debug
SAVE_PROCESSED_VARIANTS=false
MAX_UPLOAD_BYTES=15728640
MIN_IMAGE_WIDTH=320
MIN_IMAGE_HEIGHT=320

# ---------------------------------------------------------------------------
# OCR — PaddleOCR 3.4.1 / PaddlePaddle 3.3.1 (CPU)
#
# Model names are configurable so all four PP-OCRv5 combinations can be
# A/B tested against real label images without a code change.
#
# Defaults are mobile/mobile, chosen from a measurement on this hardware
# rather than from published benchmarks:
#
#   PP-OCRv5_mobile_det    1.60s median
#   PP-OCRv5_server_det   12.23s median
#
# Both produced identical text on the same image. Published figures suggested
# a 2.5x gap; the real gap here is 7.6x. Re-measure once real Reliance Retail label
# images exist — server detection may earn its cost on glare and small print.
# ---------------------------------------------------------------------------
OCR_DET_MODEL_NAME=PP-OCRv5_mobile_det
OCR_REC_MODEL_NAME=PP-OCRv5_mobile_rec
OCR_MODEL_DIR=./models

OCR_USE_TEXTLINE_ORIENTATION=false
OCR_USE_DOC_ORIENTATION_CLASSIFY=false
OCR_USE_DOC_UNWARPING=false

OCR_DET_LIMIT_SIDE_LEN=960
OCR_DET_LIMIT_TYPE=max
OCR_DET_THRESH=0.3
OCR_DET_BOX_THRESH=0.6
OCR_REC_SCORE_THRESH=0.0

# 1 is measured fastest on CPU, against intuition. Batched recognition pads
# every crop to the widest in the batch, and label text varies wildly in
# width, so batching mostly processes padding. Measured on a 10-region label:
#   batch 1 = 3.77s   batch 6 = 5.26s   batch 16 = 6.11s
OCR_REC_BATCH_SIZE=1

# PaddlePaddle 3.3.1 on Windows CPU crashes inside its oneDNN backend during
# text detection:
#   NotImplementedError: (Unimplemented) ConvertPirAttribute2RuntimeAttribute
#   not support [pir::ArrayAttribute<pir::DoubleAttribute>]
# Disabling oneDNN is the workaround. Do not enable without re-testing
# detection end to end.
OCR_ENABLE_MKLDNN=false

OCR_WARMUP_ON_STARTUP=true

# Preprocessing variants, tried in order until one finds text. Each costs a
# full OCR pass, so the default is a single variant.
# Available: original, enhanced, threshold
OCR_VARIANTS=original

# ---------------------------------------------------------------------------
# Field extraction (Phase 2)
# ---------------------------------------------------------------------------
FIELD_ALIAS_CONFIG=./config/field_aliases.yaml
CONFIDENCE_HIGH_THRESHOLD=0.92
CONFIDENCE_REVIEW_THRESHOLD=0.80

# ---------------------------------------------------------------------------
# Printer — Zebra ZQ320 over Bluetooth via ZSDK (Link-OS), ZPL
# The Android app owns the Bluetooth connection; the server prepares payloads.
# ---------------------------------------------------------------------------
PRINTER_DPI=203
QR_SIZE_MM=10
QR_MAGNIFICATION=2
QR_ERROR_CORRECTION=M

# --- Vision-language model ------------------------------------------
# Second recognition engine, run only when PP-OCRv5 comes up short.
# Measured on the 20-image corpus: fires on 53% of scans, taking mean
# latency from 6.1s to about 53s. See app/config.py for the trigger.
VLM_ENABLED=true
VLM_MODEL=qwen3-vl:4b-instruct
VLM_TRIGGER=always
VLM_FALLBACK_BELOW_CORE_FIELDS=2
